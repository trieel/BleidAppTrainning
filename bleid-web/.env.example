NEXT_PUBLIC_API_URL=http://localhost:5000

# Supabase - copiar a .env.local (gitignored) y completar los valores reales.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb-publishable-key>
# Claves solo servidor (nunca prefijo NEXT_PUBLIC_):
SUPABASE_SERVICE_KEY=<sb-secret-key>
# Los proyectos nuevos usan JWT signing keys asimetricas; solo completar si
# Project Settings > JWT Settings tambien muestra un legacy JWT Secret.
SUPABASE_JWT_SECRET=<legacy-jwt-secret-if-available>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
